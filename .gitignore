# NOTE: vendor/python/ (the embedded Windows runtime, ~97 MB) IS committed on
# purpose — the bench is offline and its only Python is an untouchable 2.x, so
# "download the repo" has to be enough on its own.  See vendor/README.md;
# rebuild with tools/make_offline_bundle.py.  Only build leftovers are ignored:
vendor/wheels/
.bundle-cache/

# local run defaults incl. admin/broadband passwords (cli.py setup)
router.yaml

# local perf-matrix config (topology / creds in dial_modes params); commit perf.example.yaml instead
perf.yaml

# 运行产物:截图/诊断证据。都是每次跑动现场生成的,不进仓库
# (diagnose 产物可能含会话 token / 表单里的账号密码 —— 回传前先脱敏)
artifacts/
recordings/

__pycache__/
*.pyc
.DS_Store
venv/
.venv/

# diagnose evidence dumps may contain session tokens / form values -- never commit
artifacts/diagnose_*.json

# Chariot 的原始测试记录。正常情况下它们落在 artifacts/ 里(已忽略),
# 这条是兜底:旧版本会把它们丢在仓库根目录。
*.tst
